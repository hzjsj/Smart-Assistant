# ── MySQL 连接配置 ──────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_assistant

# 可选：完整连接串，设置后覆盖以上分项
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/smart_assistant?charset=utf8mb4

# ── 大模型平台（OpenAI 兼容端点，key 请自行申请）──────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ─── 阿里云 OSS（对象存储，图片/文档转存）─────────────────────────────
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=cn-shanghai
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com

# ─── MinerU（文档解析）──────────────────────────────────────────────
MINERU_TOKEN=
MINERU_UID=
MINERU_SEED=
MINERU_CALLBACK_URL=

# 可选：按模型覆盖上下文窗口（tokens）
# MODEL_CONTEXT_qwen3_8_max=262144
