# ── MySQL 连接配置 ──────────────────────────────────────────────
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=smart_assistant

# 可选：完整连接串，设置后覆盖以上分项
# DATABASE_URL=mysql+pymysql://root:password@127.0.0.1:3306/smart_assistant?charset=utf8mb4

# ── 大模型平台（OpenAI 兼容端点，key 请自行申请）──────────────────
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com

BAILIAN_API_KEY=
BAILIAN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

ARK_API_KEY=
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3

# ─── 阿里云 OSS（对象存储，图片/文档转存）─────────────────────────────
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_BUCKET=
OSS_REGION=cn-shanghai
OSS_ENDPOINT=oss-cn-shanghai.aliyuncs.com

# ─── MinerU（文档解析）──────────────────────────────────────────────
MINERU_TOKEN=
MINERU_UID=
MINERU_SEED=
MINERU_CALLBACK_URL=

# 可选：按模型覆盖上下文窗口（tokens）
# MODEL_CONTEXT_qwen3_8_max=262144

# ─── 切题模块（题图存 OSS kdsa 桶，复用上方 OSS_* 配置）──────────────
# 阿里云 EduTutor（切题识别）
ALIBABA_CLOUD_ACCESS_KEY_ID=
ALIBABA_CLOUD_ACCESS_KEY_SECRET=
EDUTUTOR_ENDPOINT=edututor.cn-hangzhou.aliyuncs.com
EDUTUTOR_WORKSPACE_ID=llm-5tl2i6iigxxczoc1

# ─── Open WebUI 网关（MinerU Cloud API 兼容层）───────────────────────
# Open WebUI 可达的本服务地址，写入改写后的上传/下载 URL
# Open WebUI 侧配置: MINERU_API_URL=http://<本服务>:5000/api/mineru/proxy
# MINERU_PROXY_PUBLIC_BASE=http://127.0.0.1:5000

# ─── hermes 对话（多模型代理 + 会话持久化）─────────────────────────
HERMES_AGENT_BASE_URL=http://127.0.0.1:8642/v1
HERMES_AGENT_API_KEY=
HERMES_AGENT_MODEL=hermes-agent
HERMES_AGENT_CONNECT_TIMEOUT=10
HERMES_AGENT_READ_TIMEOUT=300
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_CONNECT_TIMEOUT=10
DEEPSEEK_READ_TIMEOUT=300
DIFY_API_KEY=
DIFY_BASE_URL=
DIFY_AGENT_ID=
DIFY_CONNECT_TIMEOUT=10
DIFY_READ_TIMEOUT=300
DASHSCOPE_API_KEY=
BAILIAN_APP_ID=
MINERU_CALLBACK_URL=
